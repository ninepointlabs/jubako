        {"name": "creator", "label": "By"},
        {"name": "kind", "label": "Kind"},
        {"name": "year", "type": "integer", "label": "Year"},
        {"name": "genre", "label": "Genre"},
        {"name": "condition", "label": "Condition"},
        {"name": "value", "type": "real", "label": "Value"},
        {"name": "lent_to", "type": "lookup", "target": "people", "show": "name", "label": "Lent to"},
        {"name": "acquired_on", "type": "date", "label": "Got it"},
        {"name": "favourite", "type": "boolean", "label": "Favourite"}
