    {"table": "collection", "name": "A to Z", "sort": [{"field": "title"}], "default": true},
    {"table": "people", "name": "A to Z", "sort": [{"field": "name"}], "default": true}
  ],
  "reports": [
    {"name": "Collection by kind", "table": "collection", "title": "The collection",
